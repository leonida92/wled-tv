<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Automation Control Guide"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Trigger ambient capture from Home Assistant automations"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Section 1: Android TV ADB Commands -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Option 1: Android TV ADB Commands (Recommended)"
        android:textColor="@color/accent_cyan"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Call via androidtv.adb_command service in your automations:"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_selector"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Start: am broadcast -a com.wled.tv.ACTION_START&#10;Pause: am broadcast -a com.wled.tv.ACTION_PAUSE&#10;Resume: am broadcast -a com.wled.tv.ACTION_RESUME&#10;Stop: am broadcast -a com.wled.tv.ACTION_STOP&#10;Toggle: am broadcast -a com.wled.tv.ACTION_TOGGLE&#10;Reload: am broadcast -a com.wled.tv.ACTION_RELOAD_CONFIG"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Section 2: Home Assistant WebSocket Event -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Option 2: Home Assistant WebSocket Event"
        android:textColor="@color/accent_amber"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Fire event in HA Developer Tools or Automation Action:"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_selector"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Event: wled_tv_control&#10;Data: { &quot;action&quot;: &quot;pause&quot; }  (or &quot;resume&quot; / &quot;start&quot; / &quot;toggle&quot; / &quot;stop&quot;)&#10;&#10;Note: &quot;pause&quot; turns off lights while keeping WebSocket connected so &quot;resume&quot; works without service relaunch."
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Example Use Case -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Example: Trigger ACTION_START whenever Jellyfin, Plex, or YouTube is launched on this Android TV."
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

</LinearLayout>
