<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Home Assistant Server"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Configure WebSocket connection to your Home Assistant instance"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- 1. Server Host / IP -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Server Host / IP"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogHaHost"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card_selector"
        android:hint="e.g. 192.168.1.100 or homeassistant.local"
        android:imeOptions="actionNext"
        android:inputType="textUri"
        android:maxLines="1"
        android:nextFocusDown="@+id/etDialogHaPort"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <!-- 2. Port -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Port (Default 8123)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogHaPort"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card_selector"
        android:hint="8123"
        android:imeOptions="actionNext"
        android:inputType="number"
        android:maxLines="1"
        android:nextFocusUp="@+id/etDialogHaHost"
        android:nextFocusDown="@+id/btnDialogToggleSsl"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <!-- 3. SSL Toggle (Full-width card for seamless DPAD navigation) -->
    <LinearLayout
        android:id="@+id/btnDialogToggleSsl"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusUp="@+id/etDialogHaPort"
        android:nextFocusDown="@+id/etDialogHaToken"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Connection Security (SSL)"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogSslStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_button"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="HTTP / WS"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. Token -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Long-Lived Access Token"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogHaToken"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card_selector"
        android:hint="Paste Long-Lived Token from HA User Profile"
        android:imeOptions="actionDone"
        android:inputType="textPassword"
        android:maxLines="1"
        android:nextFocusUp="@+id/btnDialogToggleSsl"
        android:nextFocusDown="@+id/btnDialogTestConnection"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <!-- 5. Test Connection -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogTestConnection"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_selector"
            android:nextFocusUp="@+id/etDialogHaToken"
            android:nextFocusDown="@+id/btnDialogSave"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Test Connection"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogConnectionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Status: Not tested"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 6. Action Buttons: Save & Cancel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_selector"
            android:nextFocusUp="@+id/btnDialogTestConnection"
            android:nextFocusRight="@+id/btnDialogSave"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnDialogSave"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_button_selector"
            android:nextFocusLeft="@+id/btnDialogCancel"
            android:nextFocusUp="@+id/btnDialogTestConnection"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Save"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
